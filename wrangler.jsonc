{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buy",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "b.uy", "custom_domain": true },
    { "pattern": "www.b.uy", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*", "/.well-known/*", "/buy", "/buy/*", "/r/*"]
  },
  "kv_namespaces": [
    { "binding": "ORDERS", "id": "1a9b170d5f2f4b0eaac6ff4d3e962537" }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SITE_ORIGIN": "https://b.uy",
    "TRANSAK_ENV": "staging"
  }
}
